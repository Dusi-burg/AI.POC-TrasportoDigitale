<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Runner NUnit su Microsoft.Testing.Platform, come impostato in global.json -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Dusiburg.AI.Trasporto.Eval\Dusiburg.AI.Trasporto.Eval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden set e casi di valutazione, copiati accanto ai test con la stessa struttura di data/ -->
    <Content Include="..\..\data\golden_*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\cmr\*.pdf" Link="data\cmr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\golden_cmr\**\*.*" Link="data\golden_cmr\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
