<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- UI della demo: nessun accesso al database né ai modelli, solo HTTP verso i servizi proprietari dei dati -->
  <ItemGroup>
    <ProjectReference Include="..\Dusiburg.AI.Trasporto.ServiceDefaults\Dusiburg.AI.Trasporto.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CMR sintetici della demo, copiati accanto alla Web: si scaricano e si caricano dalle pagine -->
    <Content Include="..\..\data\cmr\*.pdf" Link="demo-cmr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
