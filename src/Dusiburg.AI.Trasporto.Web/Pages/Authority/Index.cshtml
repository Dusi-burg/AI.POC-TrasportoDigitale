@page
@using Dusiburg.AI.Trasporto.Web.Agents
@model Dusiburg.AI.Trasporto.Web.Pages.Authority.IndexModel
@{
    ViewData["Title"] = "Controllo su strada";
}

<h1 class="h3">Controllo su strada</h1>
<p class="text-muted">Dalla targa del mezzo a ciò che ha <strong>a bordo in questo momento</strong> — già preso in carico e non ancora consegnato — e da lì ai soli dati che l'autorità può leggere.
    Ogni consultazione è registrata, e l'operatore la vede sulla sua spedizione.</p>
<partial name="_Messages" model="Model" />

<form method="get" class="row g-2 align-items-end mb-3" id="plate-search">
    <div class="col-auto">
        <label for="Plate" class="form-label small mb-0">Targa della motrice o del rimorchio</label>
        <input name="Plate" id="Plate" value="@Model.Plate" class="form-control" placeholder="ZZ104AA" required />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Cerca</button></div>
</form>

@if (Model.Moments is { } moments && (moments.Moments.Count > 0 || Model.At is not null))
{
    @* Aiuto per la demo: i dati hanno date fisse, quindi si può rifare il controllo com'era in un altro momento recente. *@
    <div class="border rounded p-2 mb-4 small" id="control-moments">
        <span class="badge text-bg-secondary">simulazione</span>
        <span class="text-muted">Momento del controllo — nella realtà è sempre adesso:</span>
        <a class="btn btn-sm @(Model.At is null ? "btn-secondary" : "btn-outline-secondary") ms-1" asp-route-Plate="@Model.Plate">Adesso</a>
        @foreach (ControlMomentView moment in moments.Moments)
        {
            <a class="btn btn-sm @(Model.At == moment.At ? "btn-secondary" : "btn-outline-secondary") ms-1" asp-route-Plate="@Model.Plate"
               asp-route-At="@moment.At.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" data-moment>@Presentation.Moment(moment.At) · @moment.Consignments a bordo</a>
        }
    </div>
}

@if (Model.Identifiers is { } identifiers)
{
    string when = Model.At is { } simulated ? $"il {Presentation.Moment(simulated)}" : "adesso";

    @if (identifiers.Count == 0)
    {
        <p class="text-muted" id="no-identifiers">Nessuna spedizione a bordo di <strong>@Model.Plate</strong> @when: il mezzo è scarico, oppure ciò che porta non è stato pubblicato sul gate.</p>
    }
    else
    {
        <h2 class="h5" id="on-board">A bordo di @Model.Plate @when: @(identifiers.Count == 1 ? "una spedizione" : $"{identifiers.Count} spedizioni")</h2>
        @if (identifiers.Count > 1)
        {
            <p class="small text-muted">Più spedizioni sullo stesso mezzo sono un carico a collettame: ognuna ha il suo UIL e i suoi dati.</p>
        }
        <div id="identifiers">
            @foreach (ConsignmentIdentifiersView found in identifiers)
            {
                <div class="card mb-3" data-uil="@found.Uil">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div><span class="small text-muted">UIL</span> <code class="text-break">@found.Uil</code></div>
                            <div>
                                @foreach (string subset in IndexModel.Subsets)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-route-Plate="@Model.Plate" asp-route-At="@Model.AtValue" asp-route-Uil="@found.Uil" asp-route-SubsetId="@subset" asp-fragment="subset">Leggi @subset</a>
                                }
                            </div>
                        </div>
                        <div class="small mt-2">
                            @foreach (SummaryLine line in SubsetSummary.From(found.Identifiers))
                            {
                                <span class="me-3"><span class="text-muted">@line.Label:</span> @line.Value</span>
                            }
                        </div>
                        <details class="mt-2">
                            <summary class="small">Identificatori</summary>
                            <pre class="bg-light border rounded p-2 small mt-2 mb-0">@Presentation.Json(found.Identifiers)</pre>
                        </details>
                    </div>
                </div>
            }
        </div>
    }
}

@if (Model.Subset is { } subsetView)
{
    <h2 class="h5" id="subset">Sottoinsieme @subsetView.SubsetId <span class="small text-muted fs-6">schema @subsetView.SchemaVersion · <code class="text-break">@subsetView.Uil</code></span></h2>
    <p class="small text-muted">Solo gli elementi che lo schema assegna a questo sottoinsieme: il resto del dataset non esce dalla piattaforma.</p>
    <table class="table table-sm w-auto" id="subset-summary">
        <tbody>
            @foreach (SummaryLine line in SubsetSummary.From(subsetView.Dataset))
            {
                <tr><th class="text-nowrap">@line.Label</th><td>@line.Value</td></tr>
            }
        </tbody>
    </table>
    <details>
        <summary class="small">Dato eFTI (JSON)</summary>
        <p class="small text-muted mt-2 mb-1">È il dato come lo riceve un sistema: nomi e codici dello schema eFTI, e numeri nel formato del JSON, dove il punto separa i decimali (<code>5300.000</code> sono 5.300 kg).</p>
        <pre class="bg-light border rounded p-3 small" id="subset-json">@Presentation.Json(subsetView.Dataset)</pre>
    </details>
}

<div class="card mt-4" id="authority-agent">
    <div class="card-body">
        <h2 class="h5 card-title">Chiedi all'agente</h2>
        <p class="card-text small text-muted">L'agente cerca ciò che il mezzo ha a bordo @(Model.At is { } agentMoment ? $"il {Presentation.Moment(agentMoment)}" : "adesso"), legge i sottoinsiemi di ogni spedizione e risponde <strong>solo</strong> con ciò che vi trova. Ha due tool di lettura, nessuno di scrittura.
            I valori che cita vengono confrontati con i dati letti: quelli che non vi compaiono sono segnalati.</p>
        <form data-agent-stream="@AgentStreamEndpoints.AuthorityPath" data-agent-done="answer" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            @if (Model.AtValue is { } at)
            {
                @* Lo stesso momento della ricerca: l'agente guarda il carico che è nella pagina. *@
                <input type="hidden" name="at" value="@at" />
            }
            <div class="col-md-3">
                <label for="agent-plate" class="form-label small mb-0">Targa</label>
                <input name="plate" id="agent-plate" value="@Model.Plate" class="form-control" placeholder="ZZ104AA" required />
            </div>
            <div class="col-md-7">
                <label for="agent-question" class="form-label small mb-0">Domanda</label>
                <input name="question" id="agent-question" class="form-control" placeholder="Il mezzo trasporta merci pericolose? Quali?" required />
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Chiedi</button></div>
            <div class="col-12 small text-muted" data-agent-time></div>
        </form>
        <ul class="list-unstyled small mt-3 mb-0" data-agent-steps></ul>
        <div class="alert alert-danger mt-3 mb-0" role="alert" data-agent-error hidden></div>
        <div class="mt-3" data-agent-result hidden></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/agents.js" asp-append-version="true"></script>
}
